 }
 
 TEST_F(CompositorFrameSinkSupportTestBase,
-       OnSaveTransitionDirectiveProcessedPendingAnimateManagerSurvivesCleanup) {
+       OnSaveTransitionDirectiveProcessedPendingAnimateLeavesManagerCached) {
   blink::ViewTransitionToken token_x;
 
   SubmitCompositorFrameWithResources({});
@@ -3116,8 +3116,15 @@ TEST_F(CompositorFrameSinkSupportTestBase,
 
   OnSaveTransitionDirectiveProcessed(support_.get(), save_directive);
 
