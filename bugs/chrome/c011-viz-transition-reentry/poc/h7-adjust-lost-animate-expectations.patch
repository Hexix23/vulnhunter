+  // Product route is reached: CacheSurfaceAnimationManager() notifies Surface,
+  // Surface activates its pending frame, and the Animate directive is
+  // processed synchronously. But the old local map key still exists with a
+  // moved-out manager, so kAnimateRenderer erases that key and returns before
+  // taking the freshly cached global manager. The transition is lost and the
+  // manager remains cached globally until an explicit Release.
+  EXPECT_FALSE(surface_b->HasPendingFrame());
+  EXPECT_TRUE(HasAnimationManagerForToken(token_x));
+  EXPECT_FALSE(SupportHasSurfaceAnimationManagerForToken(support_.get(),
+                                                        token_x));
