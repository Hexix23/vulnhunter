@@ -367,0 +383,38 @@
+TEST_F(FrameSinkBundleImplTest,
+       OnSaveTransitionDirectiveProcessedBundleClientIsAsync) {
+  auto frame_a =
+      std::make_unique<TestFrameSink>(manager(), kSubFrameA, kMainFrame,
+                                      kBundleId);
+  CompositorFrameSinkSupport* support = manager().GetFrameSinkForId(kSubFrameA);
+  ASSERT_TRUE(support);
+
+  blink::ViewTransitionToken token;
+  auto save_directive = CompositorFrameTransitionDirective::CreateSave(
+      token, /*maybe_cross_frame_sink=*/true, 1, {}, {}, false);
+
+  support->SubmitCompositorFrame(kSurfaceA,
+                                 MakeDefaultCompositorFrame(kBeginFrameSourceId));
+  SurfaceId surface_id(kSubFrameA, kSurfaceA);
+  Surface* surface = manager().surface_manager()->GetSurfaceForId(surface_id);
+  ASSERT_TRUE(surface);
+
+  support->ProcessCompositorFrameTransitionDirectiveForTesting(save_directive,
+                                                               surface);
+
+  test_client().SetOnTransitionDirectiveProcessedForTesting(
+      base::BindLambdaForTesting([&]() { frame_a.reset(); }));
+
+  support->OnSaveTransitionDirectiveProcessedForTesting(save_directive);
+
+  // Product bundled path calls BundleClientProxy synchronously, but the proxy
+  // only sends over a mojo::Remote<FrameSinkBundleClient>. The receiver should
+  // not run before OnSaveTransitionDirectiveProcessed() returns.
+  EXPECT_TRUE(frame_a);
+  EXPECT_NE(nullptr, manager().GetFrameSinkForId(kSubFrameA));
+
+  FlushClientReceiverForTesting();
+
+  EXPECT_FALSE(frame_a);
+  EXPECT_EQ(nullptr, manager().GetFrameSinkForId(kSubFrameA));
+}
