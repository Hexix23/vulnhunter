+        it(`A13 probe: should isolate concurrent renderApplication platform providers (zoneless:${zoneless})`, async () => {
+          const REQUEST_SECRET = new InjectionToken<string>('A13_REQUEST_SECRET');
+
+          @Component({
+            standalone: true,
+            selector: 'app',
+            template: `secret={{ secret }} doc={{ docMarker }}`,
+          })
+          class A13RequestApp {
+            secret = inject(REQUEST_SECRET);
+            docMarker = inject(DOCUMENT).body.getAttribute('data-a13');
+          }
+
+          const bootstrap = getStandaloneBootstrapFn(A13RequestApp, [
+            {
+              provide: APP_INITIALIZER,
+              useValue: () => new Promise((resolve) => setTimeout(resolve, 10)),
+              multi: true,
+            },
+          ]);
+
+          const renderA = renderApplication(bootstrap, {
+            document: '<html><head></head><body data-a13="doc-A"><app></app></body></html>',
+            platformProviders: [{provide: REQUEST_SECRET, useValue: 'secret-A'}],
+          });
+          const renderB = renderApplication(bootstrap, {
+            document: '<html><head></head><body data-a13="doc-B"><app></app></body></html>',
+            platformProviders: [{provide: REQUEST_SECRET, useValue: 'secret-B'}],
+          });
+
+          const [outputA, outputB] = await Promise.all([renderA, renderB]);
+
+          expect(outputA).toContain('secret=secret-A doc=doc-A');
+          expect(outputA).not.toContain('secret-B');
+          expect(outputA).not.toContain('doc-B');
+          expect(outputB).toContain('secret=secret-B doc=doc-B');
+          expect(outputB).not.toContain('secret-A');
+          expect(outputB).not.toContain('doc-A');
+        });
