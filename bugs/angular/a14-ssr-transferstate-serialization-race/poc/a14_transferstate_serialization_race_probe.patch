+const A14_REQUEST_SECRET = new InjectionToken<string>('A14_REQUEST_SECRET');
+const A14_STATE_KEY = makeStateKey<string>('a14-secret');
+
+function createA14TransferStateApp(standalone: boolean) {
+  @Component({
+    standalone,
+    selector: 'app',
+    template: `transfer-race`,
+  })
+  class A14TransferStateApp {
+    constructor() {
+      const transferState = coreInject(TransferState);
+      const secret = coreInject(A14_REQUEST_SECRET);
+      const doc = coreInject(DOCUMENT);
+      transferState.onSerialize(A14_STATE_KEY, () => {
+        return `${secret}|${doc.body.getAttribute('data-a14')}`;
+      });
+    }
+  }
+
+  return A14TransferStateApp;
+}
+
+const A14AsyncSerializeHookProvider = {
+  provide: BEFORE_APP_SERIALIZED,
+  useFactory: (doc: Document) => {
+    return () =>
+      new Promise<void>((resolve) => {
+        setTimeout(() => {
+          doc.body.setAttribute('data-a14-hook', doc.body.getAttribute('data-a14') ?? '');
+          resolve();
+        }, 10);
+      });
+  },
+  multi: true,
+  deps: [DOCUMENT],
+};
+
+const A14TransferStateApp = createA14TransferStateApp(false);
+const A14TransferStateAppStandalone = getStandaloneBootstrapFn(createA14TransferStateApp(true), [
+  A14AsyncSerializeHookProvider,
+]);
+
+@NgModule({
+  declarations: [A14TransferStateApp],
+  imports: [BrowserModule, ServerModule],
+  providers: [A14AsyncSerializeHookProvider],
+  bootstrap: [A14TransferStateApp],
+})
+class A14TransferStateModule {}
+
